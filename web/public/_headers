# Cloudflare Pages headers for the scroll story (web/) and the frozen first version
# under /v1/ (tools/v1/build.sh). One CSP for both: the first hash is the inline script
# in index.html (the js / stage-on classes before the first paint), the next three and
# the 'unsafe-hashes' one are v1's (Angular hydration bootstrap, the stylesheet's onload
# handler). tools/verify-csp.mjs checks them against the build in CI. blob: in img-src:
# the frame player's fallback for browsers without createImageBitmap (frames.ts).

/*
  ! Access-Control-Allow-Origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-DwjAvZAzj83c8OQ6Lc0MfWoAGZzzviO5Z4jTnXDw9+w=' 'sha256-qR3LTg2JDV04/drjHDEYjnbqb2+q2UreAtLBeLooP8Q=' 'sha256-VM2mZqyEQZoLzoTrp5EigFvzQ0+f1wSeBuoOn95WHCg=' 'sha256-8sGKvDKC8crv9OBcqEMvqrNDWlm1/80h7NJpJzqOnLI=' 'unsafe-hashes' 'sha256-MhtPZXr7+LpJUY5qtMutB+qWfQtMaPccfe7QXtCcEYc='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=(), microphone=()

# Vite's content-hashed builds and the fonts never change under the same name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The rendered frames keep their names when a sequence is rendered again, and the
# corners in meta.json have to match them: the frames a day, meta.json (no rule
# here) revalidates on every load (the Pages default). After a render that moves
# the geometry, expect up to a day of old frames with new corners, or rename the folder.
/seq/:seg/:frame
  Cache-Control: public, max-age=86400
/seq-portrait/:seg/:frame
  Cache-Control: public, max-age=86400
/scene/*
  Cache-Control: public, max-age=86400

# Stable names that rarely change.
/favicon.svg
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800
/icon-96.png
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/og-image.png
  Cache-Control: public, max-age=86400
/portrait-800.webp
  Cache-Control: public, max-age=86400

# The first version: an archive, kept out of search results.
/v1/*
  X-Robots-Tag: noindex
/v1/*.js
  Cache-Control: public, max-age=31536000, immutable
/v1/*.css
  Cache-Control: public, max-age=31536000, immutable
/v1/fonts/*
  Cache-Control: public, max-age=31536000, immutable
